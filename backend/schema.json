{
  "$defs": {
    "ListedPlayer": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "race": {
          "$ref": "#/$defs/Race"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        }
      },
      "required": [
        "id",
        "tag",
        "race",
        "country"
      ],
      "title": "ListedPlayer",
      "type": "object"
    },
    "ListedRating": {
      "properties": {
        "period_id": {
          "title": "Period Id",
          "type": "integer"
        },
        "rating": {
          "title": "Rating",
          "type": "number"
        },
        "rating_vp": {
          "title": "Rating Vp",
          "type": "number"
        },
        "rating_vt": {
          "title": "Rating Vt",
          "type": "number"
        },
        "rating_vz": {
          "title": "Rating Vz",
          "type": "number"
        },
        "position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position"
        },
        "position_vp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Vp"
        },
        "position_vt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Vt"
        },
        "position_vz": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Vz"
        },
        "decay": {
          "title": "Decay",
          "type": "integer"
        }
      },
      "required": [
        "period_id",
        "rating",
        "rating_vp",
        "rating_vt",
        "rating_vz",
        "position",
        "position_vp",
        "position_vt",
        "position_vz",
        "decay"
      ],
      "title": "ListedRating",
      "type": "object"
    },
    "ListedRatingEntry": {
      "properties": {
        "player": {
          "$ref": "#/$defs/ListedPlayer"
        },
        "current": {
          "$ref": "#/$defs/ListedRating"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListedRating"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "player",
        "current",
        "previous"
      ],
      "title": "ListedRatingEntry",
      "type": "object"
    },
    "LoginRequest": {
      "properties": {
        "username": {
          "title": "Username",
          "type": "string"
        },
        "password": {
          "title": "Password",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "LoginRequest",
      "type": "object"
    },
    "LoginResponse": {
      "properties": {
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username"
      ],
      "title": "LoginResponse",
      "type": "object"
    },
    "Race": {
      "enum": [
        "P",
        "T",
        "Z",
        "R"
      ],
      "type": "string"
    },
    "TopTenResponse": {
      "properties": {
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "ratings": {
          "items": {
            "$ref": "#/$defs/ListedRatingEntry"
          },
          "title": "Ratings",
          "type": "array"
        }
      },
      "required": [
        "period_start",
        "period_end",
        "ratings"
      ],
      "title": "TopTenResponse",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}